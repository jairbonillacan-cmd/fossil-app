<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Same Common-Controls v6 dependency tauri-build embeds by default, but
       applied to every binary of this crate (cargo test binaries included).
       Without it, test binaries crash on startup with 0xc0000139 because
       comctl32 v5 has no TaskDialogIndirect (tauri-apps/tauri#13419). -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
